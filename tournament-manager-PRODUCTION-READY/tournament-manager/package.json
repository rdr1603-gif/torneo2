{
  "name": "tournament-manager",
  "version": "1.0.0",
  "description": "Sistema profesional de gestión de torneos de pádel con Motor Inteligente",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "node prisma/seed.ts",
    "analyze": "ANALYZE=true next build",
    "health:check": "node scripts/health-check.js",
    "pre-deploy": "npm run type-check && npm run lint && npm run build"
  },
  "dependencies": {
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "next": "14.0.4",
    "@vercel/og": "^0.5.0",
    "@vercel/analytics": "^1.1.0",
    "typescript": "5.3.3",
    "next-auth": "5.0.0",
    "@prisma/client": "5.7.1",
    "prisma": "5.7.1",
    "tailwindcss": "3.4.1",
    "postcss": "8.4.32",
    "autoprefixer": "10.4.16",
    "@headlessui/react": "1.7.17",
    "@heroicons/react": "2.0.18",
    "lucide-react": "0.293.0",
    "recharts": "2.10.3",
    "react-hook-form": "7.48.0",
    "zod": "3.22.4",
    "@hookform/resolvers": "3.3.4",
    "socket.io": "4.7.2",
    "socket.io-client": "4.7.2",
    "ioredis": "5.3.2",
    "redis": "4.6.11",
    "bull": "4.11.5",
    "node-cron": "3.0.2",
    "firebase": "10.7.0",
    "firebase-admin": "12.1.0",
    "@sentry/nextjs": "7.84.0",
    "pino": "8.17.2",
    "pino-pretty": "10.3.1",
    "compression": "1.7.4",
    "helmet": "7.1.0",
    "@upstash/ratelimit": "1.1.1",
    "@upstash/redis": "1.25.0",
    "date-fns": "2.30.0",
    "clsx": "2.0.0",
    "class-variance-authority": "0.7.0"
  },
  "devDependencies": {
    "@types/node": "20.10.6",
    "@types/react": "18.2.45",
    "@types/react-dom": "18.2.18",
    "@types/compression": "1.7.5",
    "@typescript-eslint/eslint-plugin": "6.17.0",
    "@typescript-eslint/parser": "6.17.0",
    "eslint": "8.56.0",
    "eslint-config-next": "14.0.4",
    "prettier": "3.1.1",
    "jest": "29.7.0",
    "@testing-library/react": "14.1.2",
    "@testing-library/jest-dom": "6.1.5",
    "jest-environment-jsdom": "29.7.0",
    "@playwright/test": "1.41.2",
    "@next/bundle-analyzer": "14.0.4"
  },
  "engines": {
    "node": "18.17.0 || 20.10.0",
    "npm": ">=9.0.0"
  }
}
